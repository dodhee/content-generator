---
import SitesManager from '../components/SitesManager';
import Layout from '../layouts/Layout.astro';

// biome-ignore lint/correctness/noUnusedVariables: used in JSX below via client:load
const workspaceId = '';
// biome-ignore lint/correctness/noUnusedVariables: used in template
const userName = '';
---

<Layout title="Sites" showNav={true} workspaceId={workspaceId} userName={userName}>
  <div class="container mx-auto px-4 py-8">
    <SitesManager client:only="react" workspaceId={workspaceId} />
  </div>
</Layout>
