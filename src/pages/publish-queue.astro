---
import DriftDetector from '../components/DriftDetector.react';
import PublishQueueTable from '../components/PublishQueueTable.react';
import Layout from '../layouts/Layout.astro';

// biome-ignore lint/correctness/noUnusedVariables: used in JSX below via client:load
const workspaceId = '';
// biome-ignore lint/correctness/noUnusedVariables: used in template
const userName = '';
---

<Layout title="Publish Queue" showNav={true} workspaceId={workspaceId} userName={userName}>
  <div class="container mx-auto px-4 py-8">
    <div class="grid grid-cols-1 gap-8">
      <DriftDetector client:only="react" workspaceId={workspaceId} />
      <PublishQueueTable client:only="react" workspaceId={workspaceId} />
    </div>
  </div>
</Layout>
