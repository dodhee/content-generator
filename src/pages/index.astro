// src/pages/index.astro
// Root dashboard page - shows stats, today's schedule, quick actions

---
import Layout from '../layouts/Layout.astro';
import { DashboardStats } from '../components/DashboardStats';
import { TodaySchedule } from '../components/TodaySchedule';

// biome-ignore lint/correctness/noUnusedVariables: used in template below
const workspaceId = '';
// biome-ignore lint/correctness/noUnusedVariables: used in template
const userName = '';
---

<Layout title="Dashboard" showNav={true} workspaceId={workspaceId} userName={userName}>
  <div class="container mx-auto px-4 py-8">
    {/* Header */}
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">Dashboard</h1>
      <p class="text-slate-400">Overview of your content generation and publishing workflow.</p>
    </header>

    {/* Stats */}
    <DashboardStats client:load />

    {/* Quick Actions */}
    <section class="mb-8" aria-label="Quick actions">
      <h2 class="text-sm uppercase tracking-widest text-slate-500 mb-4">Quick Actions</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a
          href="/sites"
          class="flex flex-col items-center gap-3 p-6 bg-slate-800/50 border border-slate-700 rounded-lg hover:bg-slate-700/50 hover:border-cyan-500/50 transition-all text-center group"
        >
          <span class="text-3xl group-hover:scale-110 transition-transform">🌐</span>
          <span class="font-medium text-slate-100">Manage Sites</span>
          <span class="text-xs text-slate-500">Add/edit connected sites</span>
        </a>
        <a
          href="/calendar"
          class="flex flex-col items-center gap-3 p-6 bg-slate-800/50 border border-slate-700 rounded-lg hover:bg-slate-700/50 hover:border-cyan-500/50 transition-all text-center group"
        >
          <span class="text-3xl group-hover:scale-110 transition-transform">📅</span>
          <span class="font-medium text-slate-100">Content Calendar</span>
          <span class="text-xs text-slate-500">Schedule articles</span>
        </a>
        <a
          href="/calendar"
          class="flex flex-col items-center gap-3 p-6 bg-slate-800/50 border border-slate-700 rounded-lg hover:bg-slate-700/50 hover:border-cyan-500/50 transition-all text-center group opacity-50 cursor-not-allowed"
        >
          <span class="text-3xl">✨</span>
          <span class="font-medium text-slate-100">Generate Article</span>
          <span class="text-xs text-slate-500">Coming soon</span>
        </a>
        <a
          href="/publish-queue"
          class="flex flex-col items-center gap-3 p-6 bg-slate-800/50 border border-slate-700 rounded-lg hover:bg-slate-700/50 hover:border-cyan-500/50 transition-all text-center group"
        >
          <span class="text-3xl group-hover:scale-110 transition-transform">📦</span>
          <span class="font-medium text-slate-100">Publish Queue</span>
          <span class="text-xs text-slate-500">Monitor publishing</span>
        </a>
      </div>
    </section>

    {/* Today's Schedule */}
    <TodaySchedule client:load />
  </div>
</Layout>