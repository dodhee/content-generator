---
// src/pages/calendar.astro
// Calendar page with CalendarGrid island

import { CalendarGrid } from '../components/CalendarGrid';
import Layout from '../layouts/Layout.astro';

// ponytail: data di-fetch client-side oleh CalendarGrid dari /api/calendar (fase berikutnya)
// biome-ignore lint/correctness/noUnusedVariables: used in template below
const initialMonth = '';
// biome-ignore lint/correctness/noUnusedVariables: used in template below
const slots: never[] = [];
// biome-ignore lint/correctness/noUnusedVariables: used in template below
const articles: never[] = [];
// biome-ignore lint/correctness/noUnusedVariables: used in JSX below via client:load
const workspaceId = '';
---

<Layout>
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-6">Content Calendar</h1>
    <CalendarGrid
      client:load
      workspaceId={workspaceId}
      initialMonth={initialMonth}
      slots={slots}
      articles={articles}
      onSlotClick={() => {}}
      onArticleDrop={async () => {}}
      onSlotCreate={() => {}}
    />
  </div>
</Layout>