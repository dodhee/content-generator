---
// src/pages/calendar.astro
// Calendar page with CalendarGrid island

import { CalendarGrid } from '../components/CalendarGrid';
import Layout from '../layouts/Layout.astro';

// ponytail: data di-fetch client-side oleh CalendarGrid dari /api/calendar (fase berikutnya)
// biome-ignore lint/correctness/noUnusedVariables: used in template below
const initialMonth = '';
// biome-ignore lint/correctness/noUnusedVariables: used in template below
const slots: never[] = [];
// biome-ignore lint/correctness/noUnusedVariables: used in template below
const articles: never[] = [];
// biome-ignore lint/correctness/noUnusedVariables: used in JSX below via client:load
const workspaceId = '';
// biome-ignore lint/correctness/noUnusedVariables: used in template
const userName = '';
---

<Layout title="Calendar" showNav={true} workspaceId={workspaceId} userName={userName}>
  <div class="container mx-auto px-4 py-8">
    <CalendarGrid
      client:only="react"
      workspaceId={workspaceId}
      initialMonth={initialMonth}
      slots={slots}
      articles={articles}
      onSlotClick={(slot, date) => {
        if (slot.slot_type === 'generation' && slot.article_id) {
          window.location.href = `/generate?articleId=${slot.article_id}`;
        }
      }}
      onArticleDrop={async () => {}}
      onSlotCreate={() => {}}
    />
  </div>
</Layout>