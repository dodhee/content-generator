---
import '../styles/global.css';
import Navigation from '../components/Navigation.solid.tsx';

const _title = Astro.props.title || 'AI Content Generator';
const _showNav = Astro.props.showNav ?? false;
const _workspaceId = Astro.props.workspaceId || '';
const _userName = Astro.props.userName || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{_title}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    {_showNav && (
      <Navigation client:only="solid-js" workspaceId={_workspaceId} userName={_userName} />
    )}
    <main class="pt-16">
      <slot />
    </main>
  </body>
</html>