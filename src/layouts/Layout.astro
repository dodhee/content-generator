---
interface Props {
  title?: string;
  showNav?: boolean;
  workspaceId?: string;
  userName?: string;
}

const { title, showNav = false, workspaceId = '', userName = '' } = Astro.props;
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title || 'AI Auto Content Generator'}</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    {showNav && (
      <Navigation client:load workspaceId={workspaceId} userName={userName} />
    )}
    <main class="pt-16">
      <slot />
    </main>
  </body>
</html>